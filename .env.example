PORT=3000
NODE_ENV=development
# Gere um segredo longo e aleatório antes de publicar
SESSION_SECRET=troque-por-um-segredo-aleatorio-longo

# SMTP da conta que enviará os códigos (ex.: Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
MAIL_FROM=Cheat Set <seu-email@gmail.com>
